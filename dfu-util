#!/usr/bin/env bash
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ " $* " == *" --download "* ]]; then
    "${DIR}/dfu-util.bin" "$@"
    rc=$?
    sleep 0.3
    "${DIR}/dfu-util.bin" --device 05ac:ff00 --alt firmware -e -R >/dev/null 2>&1 || true
    exit $rc
else
    exec "${DIR}/dfu-util.bin" "$@"
fi
